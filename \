#version 330 core
out vec4 FragColor;

uniform float iTime;
uniform vec2 iResolution;

/* ---------- math helpers ---------- */

vec2 rot(vec2 p, float a) {
    float c = cos(a);
    float s = sin(a);
    return vec2(
        p.x * c - p.y * s,
        p.x * s + p.y * c
    );
}

/* Signed distance to axis-aligned box */
float sdBox(vec2 p, vec2 b) {
    vec2 d = abs(p) - b;
    return length(max(d, 0.0)) + min(max(d.x, d.y), 0.0);
}

/* ---------- main ---------- */

void main() {

    /* NORMALIZED SPACE */
    vec2 uv = (gl_FragCoord.xy * 2.0 - iResolution.xy) / iResolution.y;
    vec2 p = uv;

    /* TRANSFORM SPACE (rotate space, not shape) */
    p = rot(p, iTime * 0.5);

    /* SHAPE PARAMETERS */
    vec2 boxSize = vec2(0.25, 0.5);

    /* SIGNED DISTANCE */
    float dist = sdBox(p, boxSize);

    /* GLOW (distance → intensity) */
    float glow = 0.015 / (abs(dist) + 0.002);

    /* Optional pulse */
    glow *= 0.7 + 0.3 * sin(iTime * 3.0);

    /* COLOR */
    vec3 color = vec3(0.3, 0.8, 1.2);
    color *= glow;

    FragColor = vec4(color, 1.0);
}

